{
  "expo": {
    "name": "SplitLocal",
    "slug": "splitlocal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "splitlocal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.splitlocal.app"
    },
    "android": {
      "package": "com.splitlocal.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#1CC29F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "SplitLocal",
      "shortName": "SplitLocal",
      "description": "Split shared expenses with friends — no account, stored on your device.",
      "lang": "en",
      "display": "standalone",
      "startUrl": "/",
      "themeColor": "#1CC29F",
      "backgroundColor": "#F5F7FA"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1CC29F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
